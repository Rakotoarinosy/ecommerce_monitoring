# ════════════════════════════════════════════════════════
#  E-COMMERCE MONITORING — Variables d'environnement
#  Copier ce fichier en .env et remplir les valeurs
# ════════════════════════════════════════════════════════

# ─── Gmail App Password (pour AlertManager + Grafana SMTP) ───────────
# 1. Activer la validation en 2 étapes sur ton compte Google
# 2. Aller sur : https://myaccount.google.com/apppasswords
# 3. Créer un App Password "E-Commerce Monitoring"
# 4. Coller le mot de passe de 16 caractères ici (sans espaces)
GMAIL_APP_PASSWORD=xxxx-xxxx-xxxx-xxxx

# ─── Stripe ──────────────────────────────────────────────────────────
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# ─── MongoDB ─────────────────────────────────────────────────────────
MONGO_URI=mongodb://mongodb:27017
MONGO_DB_NAME=ecommerce

# ─── Passerelle de paiement (marchand BazarStore) ──────────────────────
# stripe (STRIPE_SECRET_KEY requis) | simulator (page de paiement factice, local/CI/démo)
GATEWAY_PROVIDER=stripe
# URL publique de cette API (page du simulateur)
GATEWAY_PUBLIC_URL=https://ecommerce-api.rakotoarinosy.com
# Un seul projet (BazarStore). Plusieurs projets : GATEWAY_MERCHANTS, voir le README
# GATEWAY_MERCHANTS=[{"name":"BazarStore","api_key":"…","webhook_url":"https://…","webhook_secret":"…"}]
# Secrets partagés avec BazarStore (PAYMENT_GATEWAY_API_KEY / PAYMENT_GATEWAY_WEBHOOK_SECRET)
# Générer avec : openssl rand -hex 32
GATEWAY_API_KEY=
GATEWAY_WEBHOOK_SECRET=
GATEWAY_MERCHANT_WEBHOOK_URL=https://api.bazarstore.rakotoarinosy.com/api/v1/orders/payments/gateway/webhook
# Conversion utilisée uniquement pour le modèle d'anomalies (entraîné en USD)
MGA_PER_USD=4500

# ─── Redis ───────────────────────────────────────────────────────────
REDIS_URL=redis://redis:6379/0

# ─── Grafana ─────────────────────────────────────────────────────────
GF_SECURITY_ADMIN_PASSWORD=admin123   # ⚠️ Changer en production !
